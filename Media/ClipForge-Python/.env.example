# Anthropic key for scripting / classification / highlight ranking
LLM_API_KEY=
# Anthropic key for frame understanding (may equal LLM_API_KEY)
VISION_API_KEY=
# ElevenLabs key
TTS_API_KEY=
# YouTube Data API key: discovery and the licence check before downloads
YOUTUBE_API_KEY=
# Google OAuth client (type: Desktop app) for uploads and analytics; then run `clipforge auth youtube`
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# Instagram professional account, only for publish mode: api
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Optional: webhook that receives {"text": "..."} when `clipforge run` leaves videos to review
NOTIFY_WEBHOOK_URL=
# Not used: Reddit closed new API access and TikTok posting is export-only (see docs/integrations.md)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
MAX_COST_PER_VIDEO_USD=0.50
